"""idalib worker for ``liebert_re.tools.ida`` (``ida_query``, backend ``idalib``).

Runs in a SEPARATE Python interpreter that has Hex-Rays' ``idapro`` package (the one named by
``LIEBERT_RE_IDALIB_PYTHON``), never in the harness interpreter. It is a data file (``.idapy``), not
a module: ``import idapro`` fails wherever idalib is not installed, and the wheel's smoke test
imports every ``.py`` in the package. This file must not import anything from ``liebert_re``.

The wrapper copies it into a private work directory as ``liebert_idalib_job.py`` next to a copy of
``query_program.idapy`` named ``liebert_query_ops.py``, and runs

    <python> -I liebert_idalib_job.py idalib_job.json

with that directory as the working directory. The query logic is NOT repeated here: this worker
loads ``liebert_query_ops.py`` (the very same operation functions the idat worker runs) and calls
its ``_run`` once per requested operation. ``import idapro`` is the first import of the IDA stack
(idalib initialises the kernel on import, and the ``ida_*`` modules are importable only after it).

Job file (JSON)::

    {"schema": 1, "mode": "create" | "copy", "output": "<abs path>", "ops_path": "<abs path>",
     "input": "<abs path of the raw file>"          (create only),
     "database_name": "db.i64", "log_name": "ida.log",
     "max_result_bytes": 16777216,
     "operations": [{"operation": "...", "query": "...", "max_results": 200, "offset": 0}, ...]}

* ``script`` (``ida_script``): open ``database_name`` (a COPY, as in ``copy``) and run ONE caller-written
  IDAPython script in it, with these extra job fields: ``script_path`` (the script text, UTF-8, in the
  work directory), ``script_sha256`` (the worker re-hashes the file and refuses on a mismatch),
  ``input_sha256``, ``max_result_chars``, ``max_stdout_chars``. ``operations`` and ``ops_path`` are not
  used. The script's stdout and stderr go to a bounded buffer (never to the real stdout); its answer is
  the variable ``result`` it leaves behind, which must be JSON and at most ``max_result_chars``
  characters. The outcome is the result file's ``script`` object: ``{"status": "OK" | "NO_RESULT" |
  "NOT_JSON" | "TOO_LARGE" | "EXCEPTION" | "SYNTAX_ERROR" | "HASH_MISMATCH" | "UNREADABLE", ...}`` and
  never anything parsed from stdout. The mode shares the single ``open_database`` and the
  ``close_database(False)`` ``finally`` of the other modes: whatever the script did to the open database
  is discarded. This is an accident guard, not a sandbox: nothing here restricts what the script can do
  on the host.
* ``copy``: open ``database_name`` (a COPY of the cached database, made by the wrapper; the cached
  file itself is never opened) without auto-analysis.
* ``create``: analyse ``input`` into ``database_name`` (``-o``), wait for auto-analysis to settle,
  SAVE once, then run the operations. The save happens before the first operation so that what is
  cached is the pristine analysis: a decompile that infers types cannot leak into the cache. The
  operations then run in a session that is closed WITHOUT saving.

One database per worker process. ``idapro.open_database`` is called exactly once, at one place;
a second call in the same process silently saves and closes the first database (measured), so this
file has no code path that could make it. The close is ``close_database(False)`` (discard), in a
``finally``, in both modes.

The result is a JSON file (never parsed from stdout, which IDA plugins write banners and warnings
to): ``{"results": [<one query_program result per operation>], "database_opened": ...,
"database_saved_before_queries": ..., "database_closed_without_save": ..., ..., "script_completed":
true}``, written atomically with ``script_completed`` as its last key. A result larger than
``max_result_bytes`` is replaced by a small error result; the wrapper also checks the size.
"""
import json
import os
import sys
import traceback

import idapro  # noqa: E402 - first import of the IDA stack, on purpose

SCHEMA = 1
_DEFAULT_MAX_RESULT_BYTES = 16 * 1024 * 1024
_MODES = ("create", "copy", "script")
_DEFAULT_MAX_RESULT_CHARS = 60000
_DEFAULT_MAX_STDOUT_CHARS = 16384


def _read_job(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            job = json.load(handle)
    except Exception as exc:  # noqa: BLE001
        return None, "JOB_UNREADABLE: %s: %s" % (type(exc).__name__, exc)
    if not isinstance(job, dict) or not job.get("output") or job.get("mode") not in _MODES:
        return None, "JOB_MALFORMED"
    if job["mode"] == "script":
        if not job.get("script_path") or not isinstance(job.get("script_sha256"), str):
            return None, "JOB_MALFORMED"
    elif not isinstance(job.get("operations"), list) or not job.get("ops_path"):
        return None, "JOB_MALFORMED"
    if job["mode"] == "create" and not job.get("input"):
        return None, "JOB_MALFORMED"
    return job, None


def _load_ops(path):
    """The shared operation functions (``query_program.idapy``, copied beside this file). Loaded by
    path, after the database is open; the file has no import-time side effects."""
    import importlib.machinery
    import importlib.util
    sys.dont_write_bytecode = True  # nothing but the result is written into the scratch directory
    loader = importlib.machinery.SourceFileLoader("liebert_query_ops", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def _versions():
    """Measured where possible, ``None`` where not (never a guess)."""
    found = {"idapro_version": None, "library_version": None}
    try:
        import os
        from importlib import metadata
        # The version of the distribution that OWNS the imported module; a same-named dist-info
        # elsewhere on sys.path says nothing about this module, so that case stays None.
        module_file = os.path.normcase(os.path.realpath(idapro.__file__))
        for dist in metadata.distributions(name="idapro"):
            if any(os.path.normcase(os.path.realpath(str(dist.locate_file(f)))) == module_file for f in (dist.files or [])):
                found["idapro_version"] = dist.version
                break
    except Exception:  # noqa: BLE001
        pass
    try:
        found["library_version"] = list(idapro.get_library_version())
    except Exception:  # noqa: BLE001
        pass
    return found


def _write_result(path, envelope, max_bytes):
    envelope["script_completed"] = True  # last key: a truncated file cannot carry it
    text = json.dumps(envelope, ensure_ascii=False)
    size = len(text.encode("utf-8"))
    if size > max_bytes:
        envelope = {k: v for k, v in envelope.items() if k not in ("results", "script_completed")}
        envelope.update(ok=False, error="IDALIB_RESULT_TOO_LARGE", result_bytes=size, limit_bytes=max_bytes,
                        script_completed=True)
        text = json.dumps(envelope, ensure_ascii=False)
    temporary = path + ".tmp"
    with open(temporary, "w", encoding="utf-8", newline="\n") as handle:
        handle.write(text)
    os.replace(temporary, path)


class _Capture(object):
    """The script's stdout and stderr: a bounded buffer that keeps the LAST ``limit`` characters and counts
    everything written, so a script that prints a lot cannot grow memory or reach the real stdout."""

    def __init__(self, limit):
        self.limit = max(0, int(limit))
        self.parts = []
        self.kept = 0
        self.total = 0

    def write(self, text):
        text = text if isinstance(text, str) else str(text)
        self.total += len(text)
        self.parts.append(text)
        self.kept += len(text)
        if self.kept > 2 * self.limit + 4096:
            joined = "".join(self.parts)[-self.limit:] if self.limit else ""
            self.parts, self.kept = [joined], len(joined)
        return len(text)

    def flush(self):
        pass

    def isatty(self):
        return False

    def tail(self):
        joined = "".join(self.parts)
        return joined[-self.limit:] if self.limit else ""


def _script_outcome(job):
    """Run the caller's script in the open database. Returns the ``script`` object for the result file.
    Nothing here can raise: every ending is a status."""
    import hashlib
    out = {"status": None, "compiled_by": "ida_python", "auto_wait": None}
    limit_result = int(job.get("max_result_chars") or _DEFAULT_MAX_RESULT_CHARS)
    capture = _Capture(job.get("max_stdout_chars") or _DEFAULT_MAX_STDOUT_CHARS)

    def finish(status, **fields):
        out["status"] = status
        out.update(fields)
        out["stdout_tail"] = capture.tail()
        out["stdout_chars"] = capture.total
        out["stdout_truncated"] = capture.total > len(out["stdout_tail"])
        return out

    try:
        with open(str(job["script_path"]), "rb") as handle:
            raw = handle.read()
    except OSError as exc:
        return finish("UNREADABLE", error="%s: %s" % (type(exc).__name__, exc))
    digest = hashlib.sha256(raw).hexdigest()
    out["script_sha256_seen"] = digest
    if digest != job["script_sha256"]:
        return finish("HASH_MISMATCH", expected_sha256=job["script_sha256"])
    try:
        code = compile(raw.decode("utf-8"), "<liebert_script>", "exec", dont_inherit=True)
    except (SyntaxError, ValueError, UnicodeDecodeError) as exc:
        return finish("SYNTAX_ERROR", error="%s: %s" % (type(exc).__name__, exc), line=getattr(exc, "lineno", None))
    try:
        import ida_auto
        ida_auto.auto_wait()
        out["auto_wait"] = True
    except Exception as exc:  # noqa: BLE001 - recorded, not hidden; the script still runs on what is open
        out["auto_wait"] = False
        out["auto_wait_error"] = "%s: %s" % (type(exc).__name__, exc)
    # What the database itself says its input was, read BEFORE the script runs (the wrapper compares it).
    out["engine_input_sha256"] = out["engine_input_md5"] = None
    try:
        import ida_nalt
        for key, reader in (("engine_input_sha256", ida_nalt.retrieve_input_file_sha256),
                            ("engine_input_md5", ida_nalt.retrieve_input_file_md5)):
            value = reader()
            out[key] = bytes(value).hex() if isinstance(value, (bytes, bytearray)) else (str(value) if value else None)
    except Exception:  # noqa: BLE001 - unreadable stays None; the wrapper reports provenance UNVERIFIABLE
        pass
    namespace = {"__name__": "__liebert_script__",
                 "LIEBERT_CONTEXT": {"input_sha256": job.get("input_sha256"), "max_result_chars": limit_result}}
    real_out, real_err = sys.stdout, sys.stderr
    sys.stdout = sys.stderr = capture
    failure = None
    try:
        exec(code, namespace)
    except BaseException as exc:  # noqa: BLE001 - SystemExit and KeyboardInterrupt included: the session must still close
        failure = {"type": type(exc).__name__, "message": str(exc)[:2000], "traceback": traceback.format_exc()[-6000:]}
    finally:
        sys.stdout, sys.stderr = real_out, real_err
    if failure is not None:
        return finish("EXCEPTION", exception=failure)
    if "result" not in namespace:
        return finish("NO_RESULT")
    value = namespace["result"]
    try:
        text = json.dumps(value, ensure_ascii=False, allow_nan=False)
    except Exception as exc:  # noqa: BLE001
        return finish("NOT_JSON", result_type=type(value).__name__, error="%s: %s" % (type(exc).__name__, str(exc)[:300]))
    if len(text) > limit_result:
        return finish("TOO_LARGE", result_chars=len(text), max_result_chars=limit_result, result_type=type(value).__name__)
    return finish("OK", result=json.loads(text), result_chars=len(text), result_type=type(value).__name__)


def run(job):
    """One session: open, (create: settle and save), operations, close without saving. Returns the
    result envelope and the process exit code."""
    mode = job["mode"]
    creating = mode == "create"
    scripting = mode == "script"
    envelope = {
        "ok": True, "schema": SCHEMA, "backend": "idalib", "mode": mode, "results": [],
        "database_opened": False, "database_saved_before_queries": None,
        "database_closed_without_save": False, "close_error": None, "open_rc": None,
    }
    envelope.update(_versions())
    database = os.path.abspath(str(job.get("database_name") or "db.i64"))
    log_name = str(job.get("log_name") or "ida.log")
    code = 0
    opened = False
    try:
        arguments = "-Opdb:off -L%s" % log_name
        if creating:
            arguments += " -o%s" % job.get("database_name", "db.i64")
        # The ONE open of this process. -Opdb:off: no symbol-server lookups, as on every idat launch.
        rc = idapro.open_database(str(job["input"]) if creating else database, creating, arguments)
        envelope["open_rc"] = rc
        if rc != 0:
            envelope.update(ok=False, error="IDALIB_OPEN_FAILED")
            return envelope, 0
        opened = True
        envelope["database_opened"] = True
        if scripting:
            envelope["script"] = _script_outcome(job)
            return envelope, 0
        ops = _load_ops(str(job["ops_path"]))
        if creating:
            ops._settled_function_count()  # auto-analysis settled before the pristine save
            import ida_loader
            envelope["database_saved_before_queries"] = bool(ida_loader.save_database(database, 0))
            if not envelope["database_saved_before_queries"]:
                envelope.update(ok=False, error="IDALIB_SAVE_FAILED")
                return envelope, 0
        for operation in job["operations"]:
            envelope["results"].append(ops._run(dict(operation, mode="idalib")))
    except Exception:  # noqa: BLE001
        envelope.update(ok=False, error="IDALIB_WORKER_EXCEPTION", traceback=traceback.format_exc())
        code = 3
    finally:
        if opened:
            try:
                idapro.close_database(False)  # discard: nothing this session did is kept
                envelope["database_closed_without_save"] = True
            except Exception:  # noqa: BLE001
                envelope["close_error"] = traceback.format_exc()
                code = code or 3
    return envelope, code


def main(argv):
    if len(argv) != 2:
        sys.stderr.write("liebert_idalib_job: expected one argument, the job file\n")
        return 2
    job, problem = _read_job(argv[1])
    if job is None:
        sys.stderr.write("liebert_idalib_job: %s\n" % problem)
        return 2
    envelope, code = run(job)
    try:
        _write_result(job["output"], envelope, int(job.get("max_result_bytes") or _DEFAULT_MAX_RESULT_BYTES))
    except Exception:  # noqa: BLE001
        traceback.print_exc()
        return 4
    return code


# Importing this file anywhere else (the unit tests, with stub modules) must have no side effects.
if __name__ == "__main__":
    sys.exit(main(sys.argv))
