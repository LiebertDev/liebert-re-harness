"""idalib worker for ``liebert_re.tools.ida`` (``ida_query``, backend ``idalib``).

Runs in a SEPARATE Python interpreter that has Hex-Rays' ``idapro`` package (the one named by
``LIEBERT_RE_IDALIB_PYTHON``), never in the harness interpreter. It is a data file (``.idapy``), not
a module: ``import idapro`` fails wherever idalib is not installed, and the wheel's smoke test
imports every ``.py`` in the package. This file must not import anything from ``liebert_re``.

The wrapper copies it into a private work directory as ``liebert_idalib_job.py`` next to a copy of
``query_program.idapy`` named ``liebert_query_ops.py``, and runs

    <python> -I liebert_idalib_job.py idalib_job.json

with that directory as the working directory. The query logic is NOT repeated here: this worker
loads ``liebert_query_ops.py`` (the very same operation functions the idat worker runs) and calls
its ``_run`` once per requested operation. ``import idapro`` is the first import of the IDA stack
(idalib initialises the kernel on import, and the ``ida_*`` modules are importable only after it).

Job file (JSON)::

    {"schema": 1, "mode": "create" | "copy", "output": "<abs path>", "ops_path": "<abs path>",
     "input": "<abs path of the raw file>"          (create only),
     "database_name": "db.i64", "log_name": "ida.log",
     "max_result_bytes": 16777216,
     "operations": [{"operation": "...", "query": "...", "max_results": 200, "offset": 0}, ...]}

* ``copy``: open ``database_name`` (a COPY of the cached database, made by the wrapper; the cached
  file itself is never opened) without auto-analysis.
* ``create``: analyse ``input`` into ``database_name`` (``-o``), wait for auto-analysis to settle,
  SAVE once, then run the operations. The save happens before the first operation so that what is
  cached is the pristine analysis: a decompile that infers types cannot leak into the cache. The
  operations then run in a session that is closed WITHOUT saving.

One database per worker process. ``idapro.open_database`` is called exactly once, at one place;
a second call in the same process silently saves and closes the first database (measured), so this
file has no code path that could make it. The close is ``close_database(False)`` (discard), in a
``finally``, in both modes.

The result is a JSON file (never parsed from stdout, which IDA plugins write banners and warnings
to): ``{"results": [<one query_program result per operation>], "database_opened": ...,
"database_saved_before_queries": ..., "database_closed_without_save": ..., ..., "script_completed":
true}``, written atomically with ``script_completed`` as its last key. A result larger than
``max_result_bytes`` is replaced by a small error result; the wrapper also checks the size.
"""
import json
import os
import sys
import traceback

import idapro  # noqa: E402 - first import of the IDA stack, on purpose

SCHEMA = 1
_DEFAULT_MAX_RESULT_BYTES = 16 * 1024 * 1024
_MODES = ("create", "copy")


def _read_job(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            job = json.load(handle)
    except Exception as exc:  # noqa: BLE001
        return None, "JOB_UNREADABLE: %s: %s" % (type(exc).__name__, exc)
    if not isinstance(job, dict) or not job.get("output") or job.get("mode") not in _MODES:
        return None, "JOB_MALFORMED"
    if not isinstance(job.get("operations"), list) or not job.get("ops_path"):
        return None, "JOB_MALFORMED"
    if job["mode"] == "create" and not job.get("input"):
        return None, "JOB_MALFORMED"
    return job, None


def _load_ops(path):
    """The shared operation functions (``query_program.idapy``, copied beside this file). Loaded by
    path, after the database is open; the file has no import-time side effects."""
    import importlib.machinery
    import importlib.util
    sys.dont_write_bytecode = True  # nothing but the result is written into the scratch directory
    loader = importlib.machinery.SourceFileLoader("liebert_query_ops", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def _versions():
    """Measured where possible, ``None`` where not (never a guess)."""
    found = {"idapro_version": None, "library_version": None}
    try:
        from importlib import metadata
        found["idapro_version"] = metadata.version("idapro")
    except Exception:  # noqa: BLE001
        pass
    try:
        found["library_version"] = list(idapro.get_library_version())
    except Exception:  # noqa: BLE001
        pass
    return found


def _write_result(path, envelope, max_bytes):
    envelope["script_completed"] = True  # last key: a truncated file cannot carry it
    text = json.dumps(envelope, ensure_ascii=False)
    size = len(text.encode("utf-8"))
    if size > max_bytes:
        envelope = {k: v for k, v in envelope.items() if k not in ("results", "script_completed")}
        envelope.update(ok=False, error="IDALIB_RESULT_TOO_LARGE", result_bytes=size, limit_bytes=max_bytes,
                        script_completed=True)
        text = json.dumps(envelope, ensure_ascii=False)
    temporary = path + ".tmp"
    with open(temporary, "w", encoding="utf-8", newline="\n") as handle:
        handle.write(text)
    os.replace(temporary, path)


def run(job):
    """One session: open, (create: settle and save), operations, close without saving. Returns the
    result envelope and the process exit code."""
    mode = job["mode"]
    creating = mode == "create"
    envelope = {
        "ok": True, "schema": SCHEMA, "backend": "idalib", "mode": mode, "results": [],
        "database_opened": False, "database_saved_before_queries": None,
        "database_closed_without_save": False, "close_error": None, "open_rc": None,
    }
    envelope.update(_versions())
    database = os.path.abspath(str(job.get("database_name") or "db.i64"))
    log_name = str(job.get("log_name") or "ida.log")
    code = 0
    opened = False
    try:
        arguments = "-Opdb:off -L%s" % log_name
        if creating:
            arguments += " -o%s" % job.get("database_name", "db.i64")
        # The ONE open of this process. -Opdb:off: no symbol-server lookups, as on every idat launch.
        rc = idapro.open_database(str(job["input"]) if creating else database, creating, arguments)
        envelope["open_rc"] = rc
        if rc != 0:
            envelope.update(ok=False, error="IDALIB_OPEN_FAILED")
            return envelope, 0
        opened = True
        envelope["database_opened"] = True
        ops = _load_ops(str(job["ops_path"]))
        if creating:
            ops._settled_function_count()  # auto-analysis settled before the pristine save
            import ida_loader
            envelope["database_saved_before_queries"] = bool(ida_loader.save_database(database, 0))
            if not envelope["database_saved_before_queries"]:
                envelope.update(ok=False, error="IDALIB_SAVE_FAILED")
                return envelope, 0
        for operation in job["operations"]:
            envelope["results"].append(ops._run(dict(operation, mode="idalib")))
    except Exception:  # noqa: BLE001
        envelope.update(ok=False, error="IDALIB_WORKER_EXCEPTION", traceback=traceback.format_exc())
        code = 3
    finally:
        if opened:
            try:
                idapro.close_database(False)  # discard: nothing this session did is kept
                envelope["database_closed_without_save"] = True
            except Exception:  # noqa: BLE001
                envelope["close_error"] = traceback.format_exc()
                code = code or 3
    return envelope, code


def main(argv):
    if len(argv) != 2:
        sys.stderr.write("liebert_idalib_job: expected one argument, the job file\n")
        return 2
    job, problem = _read_job(argv[1])
    if job is None:
        sys.stderr.write("liebert_idalib_job: %s\n" % problem)
        return 2
    envelope, code = run(job)
    try:
        _write_result(job["output"], envelope, int(job.get("max_result_bytes") or _DEFAULT_MAX_RESULT_BYTES))
    except Exception:  # noqa: BLE001
        traceback.print_exc()
        return 4
    return code


# Importing this file anywhere else (the unit tests, with stub modules) must have no side effects.
if __name__ == "__main__":
    sys.exit(main(sys.argv))
